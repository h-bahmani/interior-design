        "    response.headers[\"Access-Control-Allow-Methods\"] = \"GET, POST, PUT, DELETE, OPTIONS\"\n",
        "    return response\n",
        "\n",
        "@colab_app.before_request\n",
        "def handle_options():\n",
        "    if request.method == \"OPTIONS\":\n",
        "        resp = colab_app.make_response(\"\")\n",
