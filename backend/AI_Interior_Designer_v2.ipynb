        "            \"active\":     {\"booleanValue\": True},\n",
        "            \"updated_at\": {\"integerValue\": str(int(time.time()))},\n",
        "            \"secret\":     {\"stringValue\": WRITE_SECRET}\n",
        "        }\n",
        "    }\n",
        "    r = requests.patch(endpoint, json=payload, timeout=10)\n",
        "    if r.status_code == 200:\n",
