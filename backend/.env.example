# ── Gemini / Nano Banana (get a key from https://aistudio.google.com/apikey) ──
# Checked before Replicate when Colab isn't connected. No free tier for image
# generation specifically — needs billing enabled on the linked project — but
# ~$0.03-0.04/image and tends to preserve room structure better than a
# diffusion+ControlNet stack since it natively understands the photo.
GEMINI_API_KEY=your_gemini_key_here

# ── Replicate API (get token from https://replicate.com/account/api-tokens) ──
# Set this to enable always-on AI generation without Colab.
REPLICATE_API_TOKEN=r8_your_token_here

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here after deploying.
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Flask ────────────────────────────────────────────────────────────────────
# Set to "true" only in local development.
FLASK_DEBUG=false

# ── Optional: override models ─────────────────────────────────────────────────
# REPLICATE_IMG2IMG_MODEL=black-forest-labs/flux-canny-dev
# REPLICATE_INPAINT_MODEL=stability-ai/sdxl:7762fd07cf82c948538e41f63f77d685e02b063e37e496e96eefd46c929f9bdc
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image   # cheaper/faster than the default gemini-3.1-flash-image
